NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local Postgres from `yarn db:up`. These match docker-compose.yml, so you only need to change them
# if you point at a different database. In production (Render) DB_URL is injected instead.
DB_HOST=localhost
DB_PORT=2534
DB_USER=interview
DB_PASSWORD=interview
DB_NAME=interview
# DB_URL=postgres://interview:interview@localhost:2534/interview

# Set to true and list allowed origins (comma-separated) if a browser frontend calls this API.
USE_CORS=false
CORS_ORIGINS=http://localhost:5173

# For the take-home: add whatever keys your solution needs here (and in Render → Environment).
# Never commit real values.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Stedi test-mode API key (Stedi dashboard → API Keys). Sandbox checks only work with a test key.
STEDI_API_KEY=
# Shared secret the Vapi tool sends (x-vapi-secret header or Bearer token). Generate one with
# `openssl rand -hex 32`. Leave empty locally to skip the check; production refuses requests without it.
VAPI_TOOL_SECRET=
