{
  "name": "clyde-interview-base",
  "private": true,
  "packageManager": "yarn@4.9.4",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node dist",
    "dev": "tsc-watch --outdir ./dist --onsuccess \"yarn start\" --compiler typescript/bin/tsc | pino-pretty",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.test.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "APP_ENV=test jest",
    "test:db": "APP_ENV=test jest --config jest.db.config.js --runInBand",
    "faqs:eval": "LOG_LEVEL=warn TS_NODE_PROJECT=tsconfig.test.json ts-node -r tsconfig-paths/register scripts/evaluate-faqs.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "migrate": "knex migrate:latest",
    "migrate:down": "knex migrate:down",
    "migrate:make": "knex migrate:make"
  },
  "_moduleAliases": {
    "@clyde-api/config": "dist/config",
    "@clyde-api/models": "dist/models",
    "@clyde-api/server": "dist/server",
    "@clyde-api/types": "dist/types",
    "@clyde-api/utils": "dist/utils",
    "@clyde-api/knexfile": "knexfile.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "knex": "^3.1.0",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.1",
    "objection": "^3.1.5",
    "pg": "^8.16.3",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/module-alias": "^2",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5",
    "jest": "^30.2.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3"
  }
}
